# Only the Minecraft client working sources are versioned.
# Everything else (reference folders, workspace, runtime, outs) stays local.
#
# Whitelist approach: ignore everything, then re-include minecraft/src.

/*
!/.gitignore
!/minecraft

# Ignore everything inside minecraft/ except the working sources.
# Explicitly allow IDE configs and launcher scripts that are part of the project.
/minecraft/*
!/minecraft/src
!/minecraft/Client.launch
!/minecraft/Start.bat